# Shared local-development defaults. Copy to .env only when you need overrides.

# PostgreSQL / backend
POSTGRES_DB=startup_investment
POSTGRES_USER=startup_app
POSTGRES_PASSWORD=change-me-local-only
DB_URL=jdbc:postgresql://localhost:5432/startup_investment
DB_USERNAME=startup_app
DB_PASSWORD=change-me-local-only
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
DEMO_ADMIN_ENABLED=false
DEMO_ADMIN_EMAIL=admin@ventureline.local
DEMO_ADMIN_PASSWORD=

# Frontend
VITE_API_BASE_URL=http://localhost:8080
